{
  "name": "factoria-agentes",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Plataforma web multiusuario para orquestar agentes de IA que desarrollan software de forma automatizada",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/protongit/factoria-agentes.git"
  },
  "homepage": "https://github.com/protongit/factoria-agentes#readme",
  "bugs": {
    "url": "https://github.com/protongit/factoria-agentes/issues"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "lint": "oxlint apps packages",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build:turbo": "turbo run build",
    "dev:turbo": "turbo run dev",
    "typecheck:turbo": "turbo run typecheck",
    "test:turbo": "turbo run test",
    "db:generate": "pnpm --filter @factoria/db db:generate",
    "db:migrate": "pnpm --filter @factoria/db db:migrate",
    "compose:up": "docker compose up -d --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "oxlint": "^1.87.0",
    "puppeteer-core": "^25.13.0",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  }
}
