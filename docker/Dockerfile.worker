FROM node:24-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends git ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

RUN npm install -g pnpm@12.11.2

# opencode (ejecutor de agentes) se instala aquí para que el worker pueda lanzarlo.
# Se mantiene tolerante a fallos para no bloquear el arranque en F0.
RUN npm install -g opencode-ai || echo "opencode no instalado (se requiere en F4+)"

WORKDIR /app

COPY pnpm-workspace.yaml package.json .npmrc tsconfig.base.json ./
COPY packages ./packages
COPY apps/worker ./apps/worker
COPY apps/api ./apps/api
COPY apps/mcp ./apps/mcp

RUN pnpm install --no-frozen-lockfile

CMD ["pnpm", "--filter", "@factoria/worker", "start"]
